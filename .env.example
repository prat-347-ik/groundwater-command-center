NODE_ENV=production

# MongoDB
MONGO_ATLAS_URI=mongodb://localhost:27017/groundwater_db
DB_NAME_OPS=test
DB_NAME_ANALYTICS=test
DB_NAME_CLIMATE=test

# Remote access
# Set to your host machine LAN IP when opening dashboard from another PC.
# Example: HOST_IP=192.168.1.50
HOST_IP=localhost

# Comma-separated origins allowed by Service A CORS.
# Example for remote PC usage:
# ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
ALLOWED_ORIGINS=http://localhost:3000
